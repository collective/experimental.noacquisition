<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="experimental.noacquistion">

  <five:registerPackage package="." initialize=".initialize" />

  <!-- Override Products.CMFCore.explicitacquisition's own adapter, so that
       config.DRYRUN and logging are honoured. -->
  <adapter
      provides="Products.CMFCore.interfaces.IShouldAllowAcquiredItemPublication"
      factory=".native.content_allowed"
      />

</configure>
